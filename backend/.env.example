# =========================================================
#  .env.example — Variables de entorno del Backend
#  Copia este archivo como .env y rellena tus valores reales
# =========================================================

# --- Conexion a MySQL (phpMyAdmin) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=proyecto_react
DB_USER=root
DB_PASSWORD=

# --- URL completa de conexion (alternativa) ---
DATABASE_URL=mysql+pymysql://root:@localhost:3306/proyecto_react

# --- JWT ---
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Servidor ---
PORT=3000

# --- Servidor de Correo SMTP (Ejemplo con Gmail) ---
# Si usas Gmail, genera una "Contraseña de Aplicación" en myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_digitos
SMTP_FROM_EMAIL=tu_correo@gmail.com

# --- Inteligencia Artificial (Chatbot PCortes) ---
# Proveedor soportado: openai (OpenAI API) o gemini (Google Gemini API)
AI_PROVIDER=openai
# Tu clave API privada de OpenAI (NUNCA la publiques en GitHub)
OPENAI_API_KEY=tu_clave_api_de_openai_aqui
# Opcional si prefieres usar Google Gemini:
GEMINI_API_KEY=
# Modelo a utilizar (por defecto gpt-4o-mini o gemini-1.5-flash)
AI_MODEL=gpt-4o-mini

